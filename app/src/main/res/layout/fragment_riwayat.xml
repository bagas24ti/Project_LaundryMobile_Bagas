<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kilau_background"
    tools:context=".riwayat.RiwayatFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/kilau_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Riwayat Pesanan"
        app:titleTextColor="@color/kilau_white" />

    <!-- Filter Buttons Row -->
    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFilterSemua"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_blue"
            android:text="Semua"
            android:textColor="@color/kilau_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFilterAktif"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:text="Aktif"
            android:textColor="@color/kilau_navy"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFilterSelesai"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:text="Selesai"
            android:textColor="@color/kilau_navy"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/kilau_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kilau_border"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOrder1Id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="#KL-0921"
                        android:textColor="@color/kilau_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_service_item"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Diproses"
                        android:textColor="@color/kilau_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrder1Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvOrder1Id"
                        android:layout_marginTop="6dp"
                        android:text="Cuci Kiloan 3kg · Rp21.000"
                        android:textColor="@color/kilau_muted"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRepeatOrder1"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_below="@id/tvOrder1Detail"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_yellow"
                        android:paddingHorizontal="16dp"
                        android:text="Pesan Ulang"
                        android:textColor="@color/kilau_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/kilau_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kilau_border"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOrder2Id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="#KL-0874"
                        android:textColor="@color/kilau_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_service_item"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Selesai"
                        android:textColor="@color/kilau_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrder2Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvOrder2Id"
                        android:layout_marginTop="6dp"
                        android:text="Cuci Satuan (Jaket &amp; Jas) · Rp35.000"
                        android:textColor="@color/kilau_muted"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRepeatOrder2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_below="@id/tvOrder2Detail"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_yellow"
                        android:paddingHorizontal="16dp"
                        android:text="Pesan Ulang"
                        android:textColor="@color/kilau_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/kilau_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kilau_border"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOrder3Id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="#KL-0810"
                        android:textColor="@color/kilau_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_service_item"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Selesai"
                        android:textColor="@color/kilau_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrder3Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvOrder3Id"
                        android:layout_marginTop="6dp"
                        android:text="Cuci Express 5kg · Rp60.000"
                        android:textColor="@color/kilau_muted"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRepeatOrder3"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_below="@id/tvOrder3Detail"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_yellow"
                        android:paddingHorizontal="16dp"
                        android:text="Pesan Ulang"
                        android:textColor="@color/kilau_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>