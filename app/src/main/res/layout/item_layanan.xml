<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card_layanan"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="132dp"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_emoji"
        android:layout_width="85dp"
        android:layout_height="92dp"
        android:layout_gravity="center"
        android:contentDescription="@string/brand_name"
        android:src="@drawable/ic_baju_cowok" />

    <TextView
        android:id="@+id/tv_nama_layanan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:gravity="center"
        android:maxLines="1"
        android:text="Kiloan"
        android:textColor="@color/kilau_navy"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_deskripsi_layanan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:gravity="center"
        android:maxLines="1"
        android:text="Cuci pakaian harian"
        android:textColor="@color/kilau_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_harga_layanan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:gravity="center"
        android:maxLines="1"
        android:text="Rp7.000/kg"
        android:textColor="@color/kilau_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>