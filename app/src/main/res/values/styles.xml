        <item name="android:textStyle">normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#D1E2FF</item>
    </style>

    <!-- BottomNavigationView TextAppearances -->
    <style name="Widget.Kilau.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
